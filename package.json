{
  "name": "easy-quiz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "e2e": "cypress run --browser edge",
    "e2e:open": "cypress open --browser edge",
    "e2e:headed": "cypress run --browser edge --headed",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:auth-schema": "node scripts/auth-schema.mjs",
    "admin:promote": "node scripts/promote-admin.mjs",
    "sitemap:gen": "node scripts/generate-sitemap.mjs",
    "og:image": "node scripts/generate-og-image.mjs",
    "promo:graphics": "node scripts/generate-promo-graphics.mjs",
    "import:samples": "node scripts/import-samples.mjs"
  },
  "dependencies": {
    "@remotion/google-fonts": "^4.0.530",
    "@remotion/player": "^4.0.530",
    "better-auth": "^1.7.12",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "lucide-react": "^1.49.0",
    "motion": "^13.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "remotion": "^4.0.530",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261022.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "cypress": "^16.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.152.0"
  }
}
