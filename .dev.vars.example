# Copy to .dev.vars for `npm run dev`. On Cloudflare set each with `npx wrangler secret put <NAME>`.
# Any long random string (e.g. `openssl rand -base64 32`).
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Without it, account emails are only logged in the dev server's output (link included).
# RESEND_API_KEY=

# Local testing without PayOS: every order counts as paid when the buyer comes back from "checkout".
PAYOS_MOCK=1
# PAYOS_CLIENT_ID=
# PAYOS_API_KEY=
# PAYOS_CHECKSUM_KEY=

# AI Assist. AI_PROVIDER in wrangler.jsonc picks the adapter (mock needs no key); override it here
# to try a real model locally.
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
