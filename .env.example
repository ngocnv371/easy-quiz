# ---------------------------------------------------------------------------
# Easy Quiz — front-end environment
#
# Copy to `.env.local` if you need to override anything. Vite only exposes
# variables prefixed with `VITE_`. The API needs no configuration here: it is
# the Worker on the same origin (`/api/*`). Server secrets live in `.dev.vars`
# (see `.dev.vars.example`), never in this file.
# ---------------------------------------------------------------------------

# Canonical URL of the site. Used for canonical links, Open Graph/Twitter tags
# and `npm run sitemap:gen`. Keep it on localhost for development; the
# production build reads `.env.production` instead.
VITE_SITE_URL=http://localhost:5173

# Parent brand site, used by the "back to AiTechX" links.
VITE_BRAND_URL=https://aitechx.vn

# Google AdSense for the ad break after each session. Production builds already
# carry the real ids (src/features/ads/adsense.ts); set these only to override
# them, e.g. to try real ads in `npm run dev`.
# VITE_ADSENSE_CLIENT=ca-pub-0000000000000000
# VITE_ADSENSE_SLOT=0000000000

# `npm run import:samples` signs in as this admin to load `samples/*.csv`
# (sign up, confirm the email, then `npm run admin:promote -- <email>`).
# IMPORT_SITE_URL=http://localhost:5173
# IMPORT_ADMIN_EMAIL=
# IMPORT_ADMIN_PASSWORD=
