# ---------------------------------------------------------------------------
# Easy Quiz — front-end environment
#
# Copy to `.env.local` and fill in. Vite only exposes variables prefixed with
# `VITE_`; anything else stays out of the client bundle on purpose.
# ---------------------------------------------------------------------------

# Supabase API endpoint. `npx supabase start` prints the local values.
# Easy Quiz's local stack uses the 544xx range so it can run alongside other
# local Supabase projects — see supabase/config.toml.
VITE_SUPABASE_URL=http://127.0.0.1:54421

# Supabase publishable (anon) key. Safe to ship to the browser — every table is
# guarded by row level security.
VITE_SUPABASE_ANON_KEY=

# Shown in the footer and meta tags.
VITE_SITE_URL=http://localhost:5173

# Parent brand site, used by the "back to AiTechX" links.
VITE_BRAND_URL=https://aitechx.vn

# ---------------------------------------------------------------------------
# AI Assist does NOT read keys from here.
# It runs in a Supabase Edge Function so the provider key never reaches the
# browser. See `supabase/.env.example`.
# ---------------------------------------------------------------------------
