# ---------------------------------------------------------------------------
# Edge Function secrets (never commit the real file)
#
# Local:  copy to `supabase/functions/.env` then run
#         `npx supabase functions serve --env-file supabase/functions/.env`
# Remote: npx supabase secrets set --env-file supabase/functions/.env
# ---------------------------------------------------------------------------

# Which adapter `ai-quiz` uses: `gemini` | `openai` | `deepseek` | `mock`
AI_PROVIDER=mock

# --- Gemini ---------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI ---------------------------------------------------------------
# `OPENAI_BASE_URL` also makes this adapter the generic escape hatch: point it
# at any OpenAI-compatible `/chat/completions` endpoint (OpenRouter, Together,
# Groq, vLLM, Ollama…) and set AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- DeepSeek -------------------------------------------------------------
# An OpenAI-compatible endpoint, so it reuses the same adapter.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Optional shared secret so only your app can call the function.
# Set the same value as `VITE_AI_ASSIST_TOKEN` if you enable it.
AI_ASSIST_TOKEN=

# --- Payments (PayOS) -----------------------------------------------------
# From the PayOS dashboard → Kênh thanh toán → your channel. Used by the
# `payments` and `payos-webhook` functions to sell energy packs and Plus.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Where PayOS sends the buyer back after paying (no trailing slash).
SITE_URL=http://localhost:5173
# `true` skips PayOS entirely and marks every order paid on return — for
# clicking through the flow locally without credentials. Only honoured
# against a local Supabase stack.
PAYOS_MOCK=false
